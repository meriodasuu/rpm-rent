# PostgreSQL connection used in production and by Prisma migrations.
# For Supabase use:
# postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_USER=postgres
SUPABASE_DB_NAME=postgres
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DATABASE_URL=
FILE_DATABASE_PATH=
# A random 32+ character secret used to sign admin sessions.
AUTH_SECRET=
# Single-admin credentials. Generate the hash with: pnpm auth:hash -- "your password"
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Canonical public origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, enables analytics only when populated.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
# Optional confirmed customer contacts.
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_ADDRESS=
# Optional confirmed contact details and map embed URL.
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_HOURS=
NEXT_PUBLIC_MAP_EMBED_URL=
# Optional CRM webhook. Booking remains saved even when the webhook fails.
CRM_WEBHOOK_URL=
